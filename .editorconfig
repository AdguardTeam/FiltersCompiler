root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.{js,ts,cjs,mjs,json}]
indent_style = space
indent_size = 4

[revision.json]
indent_style = tab
indent_size = 4
insert_final_newline = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4
